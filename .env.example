# ==========================================
# 국방·방산 뉴스 디스코드 봇 설정 파일 (.env)
# ==========================================

# 1. 디스코드 봇 토큰 (Discord Developer Portal에서 발급)
# https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# 2. 기본 알림 채널 ID (숫자) - 봇이 자동으로 뉴스를 전송할 채널
# 디스코드 설정에서 '개발자 모드' 켠 후 채널 우클릭 -> ID 복사
DISCORD_CHANNEL_ID=123456789012345678

# 3. 디스코드 웹훅 URL (선택 사항: 봇 대신 웹훅으로만 전송하고 싶을 때 사용)
DISCORD_WEBHOOK_URL=

# 4. 뉴스 수집 주기 (단위: 분, 기본값: 15)
CHECK_INTERVAL_MINUTES=15

# 5. 1회 확인 시 최대 전송 기사 수 (스팸 방지, 기본값: 5)
MAX_ARTICLES_PER_CHECK=5

# 6. SQLite 데이터베이스 경로
DB_PATH=data/news.db

# 7. 추가 모니터링 키워드 (쉼표로 구분, 선택 사항)
CUSTOM_KEYWORDS=K2전차,천궁-II,KF-21,장보고-III,폴란드,루마니아,호주

# 8. 네이버 오픈 API 키 (선택 사항: 네이버 뉴스 검색 추가 시)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 9. 카카오톡 '나에게 보내기' 설정 (선택 사항: 개인 카카오톡으로 뉴스 수신 시)
# python kakao_auth_helper.py 실행으로 자동 발급 가능
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=

